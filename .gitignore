# Originals live outside the website in Documents/portfolio-source/. These rules
# are a safety net in case one gets copied back in: only web-sized .webp copies
# in public/assets/projects/ should be published (some originals are over GitHub's
# 100 MB limit, and the documents aren't meant to be public).
public/assets/projects/**/*.png
public/assets/projects/**/*.jpg
public/assets/projects/**/*.jpeg
public/assets/projects/**/*.heif
public/assets/projects/**/*.heic
public/assets/projects/**/*.pdf
public/assets/projects/**/*.pptx
public/assets/projects/**/*.docx

# Build output and dependencies
node_modules/
dist/

# Local review captures
.ui-review/
